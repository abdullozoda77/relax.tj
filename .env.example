SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP for letters (email confirmation codes, password reset). Leave EMAIL_HOST empty to print letters
# in the Django console instead. Gmail: turn on 2-step verification, create an "App password" at
# https://myaccount.google.com/apppasswords and put it (16 letters, no spaces) in EMAIL_HOST_PASSWORD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
